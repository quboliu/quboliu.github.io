---
import { getCollection } from "astro:content";
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Breadcrumb from "@/components/Breadcrumb.astro";
import Main from "@/components/Main.astro";
import Footer from "@/components/Footer.astro";
import PostsViewNavigation from "@/components/PostsViewNavigation.astro";
import { POST_VALUE_ASSESSMENTS } from "@/data/postValueAssessments";
import { getPostLlmAssessment } from "@/data/postLlmAssessments";
import { getSortedPosts } from "@/utils/getSortedPosts";
import { getPostUrl } from "@/utils/getPostPaths";
import { isOriginalPost } from "@/utils/isOriginalPost";
import { useTranslations } from "@/i18n";
import config from "@/config";
import dayjs from "dayjs";

type Mode = "value" | "llm";
type Props = { mode: Mode };
const { mode } = Astro.props;
const locale = Astro.currentLocale ?? config.site.lang;
const t = useTranslations(locale);
const posts = getSortedPosts(
  await getCollection(
    "posts",
    ({ data }) => !data.draft && isOriginalPost({ data })
  )
);
const missing = posts.filter(post => !POST_VALUE_ASSESSMENTS[post.id]);
if (missing.length) {
  throw new Error(
    `Reading value assessments missing for: ${missing.map(post => post.id).join(", ")}`
  );
}

const entries = posts.map(post => ({
  id: post.id,
  title: post.data.title,
  date: dayjs(post.data.pubDatetime).format("YYYY-MM-DD"),
  url: getPostUrl(post.id, post.filePath, locale),
  value: POST_VALUE_ASSESSMENTS[post.id],
  llm: getPostLlmAssessment(post.id),
}));
const sortedEntries = [...entries].sort((a, b) => {
  const aScore = mode === "value" ? a.value.score : a.llm.estimate;
  const bScore = mode === "value" ? b.value.score : b.llm.estimate;
  if (aScore === null)
    return bScore === null ? b.date.localeCompare(a.date) : 1;
  if (bScore === null) return -1;
  return bScore - aScore || b.date.localeCompare(a.date);
});
const noEvidenceCount = entries.filter(
  entry => entry.llm.kind === "no-evidence"
).length;
const isValue = mode === "value";
const pageTitle = isValue ? "阅读价值" : "LLM 文字含量";
const pageDesc = isValue
  ? "只按固定的 0–100 量尺评估本站原创文章的阅读价值；点选轴上的文章或拖动范围筛选。"
  : "只估计本站原创文章中保留的 LLM 生成或改写文字比例，并分别说明制作环节与依据。";

function llmLabel(entry: (typeof entries)[number]) {
  if (entry.llm.kind === "no-evidence") return "无依据 · 0–100%";
  if (entry.llm.kind === "no-added-prose") return "0% · 无新增正文";
  return `约 ${entry.llm.estimate}% · 范围 ${entry.llm.low}–${entry.llm.high}%`;
}
---

<Layout
  title={`${pageTitle} | ${t.pages.postsTitle} | ${config.site.title}`}
  description={pageDesc}
>
  <Header />
  <Breadcrumb />
  <Main pageTitle={t.pages.postsTitle} pageDesc={pageDesc}>
    <PostsViewNavigation active={mode} />

    <div
      id="post-axis"
      data-mode={mode}
      data-entries={JSON.stringify(entries)}
      class="pb-16"
    >
      <div
        class="border-border bg-muted/30 mb-5 rounded border px-4 py-3 text-sm"
      >
        <h2 class="font-semibold">{pageTitle}</h2>
        {
          isValue ? (
            <p class="mt-1">
              仅收录本站原创文章。数值是本站编辑评价，综合内容质量和长期适用价值。采用固定量尺，新文章加入时旧分数不会自动改变；分数不表示价值倍数。
            </p>
          ) : (
            <p class="mt-1">
              仅收录本站原创文章。分母仅含本站新增的自然语言正文，引文、代码和图示不计入。空心标记表示缺少制作依据，0–100%
              是不确定范围。
            </p>
          )
        }
      </div>

      <div
        class="border-border mb-5 flex flex-wrap items-end gap-3 border-b pb-4 text-sm"
      >
        <button
          type="button"
          data-sort
          class="border-border hover:border-accent rounded border px-3 py-1.5"
          aria-label="切换数值排序方向">排序：高 → 低 ↕</button
        >
        <label class="flex items-center gap-2">
          下限
          <input
            data-min
            type="number"
            inputmode="numeric"
            min="0"
            max="100"
            value="0"
            aria-label="筛选范围下限"
            class="border-border bg-background w-16 rounded border px-2 py-1"
          />
        </label>
        <label class="flex items-center gap-2">
          上限
          <input
            data-max
            type="number"
            inputmode="numeric"
            min="0"
            max="100"
            value="100"
            aria-label="筛选范围上限"
            class="border-border bg-background w-16 rounded border px-2 py-1"
          />
        </label>
        <button type="button" data-reset class="text-accent underline"
          >重置范围</button
        >
        {
          !isValue && (
            <button type="button" data-unknown class="text-accent underline">
              查看无依据（{noEvidenceCount}）
            </button>
          )
        }
      </div>

      <div
        class="post-axis-layout grid gap-5 xl:grid-cols-[210px_minmax(0,1fr)] xl:gap-8"
      >
        <aside
          class="border-border bg-background sticky top-4 h-fit rounded-lg border p-3 sm:p-4"
          aria-label={`${pageTitle}纵轴`}
        >
          <h2 class="mb-1 text-sm font-semibold sm:text-base">总览轴</h2>
          <p class="text-muted-foreground mb-3 text-xs">
            点选文章，拖动上下把手筛选。
          </p>
          <div
            data-axis-plot
            role="group"
            class="post-axis-plot mx-auto h-[460px] w-full"
          >
          </div>
          <p
            data-range-label
            class="text-muted-foreground mt-3 text-center text-xs"
          >
            0–100{isValue ? " 分" : "%"}
          </p>
          {
            !isValue && (
              <p class="text-muted-foreground mt-2 text-xs">
                空心标记的纵向位置不是估计值；点开可查看全部无依据文章。
              </p>
            )
          }
        </aside>

        <section class="min-w-0" aria-label={`${pageTitle}文章列表`}>
          <p
            data-result-count
            class="text-muted-foreground mb-3 text-sm"
            aria-live="polite"
          >
            显示 {entries.length} / {entries.length} 篇文章
          </p>
          <ol data-post-list class="space-y-2">
            {
              sortedEntries.map(entry => (
                <li class="border-border rounded border px-4 py-3">
                  <div class="flex flex-wrap items-baseline justify-between gap-x-3 gap-y-1">
                    <a
                      class="text-accent no-underline hover:underline"
                      href={entry.url}
                    >
                      {entry.title}
                    </a>
                    <span class="text-muted-foreground shrink-0 font-mono text-xs">
                      {isValue ? `${entry.value.score} 分` : llmLabel(entry)}
                    </span>
                  </div>
                  <p class="text-muted-foreground mt-1 text-xs">{entry.date}</p>
                  <p class="mt-2 text-sm">
                    {isValue ? entry.value.reason : entry.llm.basis}
                  </p>
                  {!isValue && (
                    <p class="text-muted-foreground mt-1 text-xs">
                      参与环节：{entry.llm.roles.join("、") || "未记录"} ·
                      范围：{entry.llm.scope}
                    </p>
                  )}
                </li>
              ))
            }
          </ol>
          <p
            data-empty
            class="text-muted-foreground hidden py-8 text-center text-sm"
          >
            这个范围内没有文章。请调整上下限或重置范围。
          </p>
        </section>
      </div>
    </div>
  </Main>
  <Footer />
</Layout>

<script>
  type Entry = {
    id: string;
    title: string;
    date: string;
    url: string;
    value: { score: number; reason: string };
    llm: {
      kind: "estimated" | "no-evidence" | "no-added-prose";
      estimate: number | null;
      low: number;
      high: number;
      roles: string[];
      scope: string;
      basis: string;
    };
  };

  let axisController: AbortController | undefined;

  function initPostAxis() {
    axisController?.abort();
    axisController = new AbortController();
    const root = document.querySelector<HTMLElement>("#post-axis");
    if (!root) return;
    const { signal } = axisController;
    const entries = JSON.parse(root.dataset.entries ?? "[]") as Entry[];
    const mode = root.dataset.mode === "llm" ? "llm" : "value";
    const unknownCount = entries.filter(
      entry => entry.llm.kind === "no-evidence"
    ).length;
    let ascending = false;
    let minimum = 0;
    let maximum = 100;
    let unknownOnly = false;
    let selectedId: string | undefined;

    const score = (entry: Entry) =>
      mode === "value" ? entry.value.score : entry.llm.estimate;
    const fullRange = () => minimum === 0 && maximum === 100;
    const axisY = (value: number) =>
      8 + (ascending ? value : 100 - value) * 0.84;
    const isVisible = (entry: Entry) => {
      if (mode === "llm" && unknownOnly)
        return entry.llm.kind === "no-evidence";
      if (mode === "llm" && entry.llm.kind === "no-evidence")
        return fullRange();
      const value = score(entry);
      return value !== null && value >= minimum && value <= maximum;
    };
    const compare = (a: Entry, b: Entry) => {
      if (unknownOnly) return b.date.localeCompare(a.date);
      const aScore = score(a);
      const bScore = score(b);
      if (aScore === null)
        return bScore === null ? b.date.localeCompare(a.date) : 1;
      if (bScore === null) return -1;
      return (
        (ascending ? aScore - bScore : bScore - aScore) ||
        b.date.localeCompare(a.date)
      );
    };
    const displayScore = (entry: Entry) => {
      if (mode === "value") return `${entry.value.score} 分`;
      if (entry.llm.kind === "no-evidence") return "无依据 · 0–100%";
      if (entry.llm.kind === "no-added-prose") return "0% · 无新增正文";
      return `约 ${entry.llm.estimate}% · 范围 ${entry.llm.low}–${entry.llm.high}%`;
    };

    function element<K extends keyof HTMLElementTagNameMap>(
      tag: K,
      content: string,
      className = ""
    ) {
      const node = document.createElement(tag);
      node.textContent = content;
      node.className = className;
      return node;
    }

    function highlightSelection() {
      root?.querySelectorAll<HTMLElement>("[data-entry-id]").forEach(node => {
        node.classList.toggle(
          "post-axis-selected",
          node.dataset.entryId === selectedId
        );
      });
    }

    function makeRow(entry: Entry) {
      const item = element("li", "", "border-border rounded border px-4 py-3");
      item.dataset.entryId = entry.id;
      const header = element(
        "div",
        "",
        "flex flex-wrap items-baseline justify-between gap-x-3 gap-y-1"
      );
      const link = element(
        "a",
        entry.title,
        "text-accent min-w-0 no-underline hover:underline"
      );
      link.href = entry.url;
      header.append(
        link,
        element(
          "span",
          displayScore(entry),
          "text-muted-foreground shrink-0 font-mono text-xs"
        )
      );
      item.append(header);
      item.append(
        element("p", entry.date, "text-muted-foreground mt-1 text-xs")
      );
      item.append(
        element(
          "p",
          mode === "value" ? entry.value.reason : entry.llm.basis,
          "mt-2 text-sm"
        )
      );
      if (mode === "llm") {
        item.append(
          element(
            "p",
            `参与环节：${entry.llm.roles.join("、") || "未记录"} · 范围：${entry.llm.scope}`,
            "text-muted-foreground mt-1 text-xs"
          )
        );
      }
      item.addEventListener(
        "mouseenter",
        () => {
          selectedId = entry.id;
          highlightSelection();
        },
        { signal }
      );
      link.addEventListener(
        "focus",
        () => {
          selectedId = entry.id;
          highlightSelection();
        },
        { signal }
      );
      return item;
    }

    function addPlot(plot: HTMLElement, visible: Entry[]) {
      plot.replaceChildren();
      plot.setAttribute(
        "aria-label",
        `${mode === "value" ? "阅读价值" : "LLM 文字含量"}轴，当前显示 ${visible.length} 篇文章`
      );
      plot.append(element("div", "", "post-axis-line"));
      const top = Math.min(axisY(minimum), axisY(maximum));
      const bottom = Math.max(axisY(minimum), axisY(maximum));
      const band = element("div", "", "post-axis-range-band");
      band.style.top = `${top}%`;
      band.style.bottom = `${100 - bottom}%`;
      plot.append(band);

      for (const tick of [0, 25, 50, 75, 100]) {
        const mark = element("span", String(tick), "post-axis-tick");
        mark.style.top = `${axisY(tick)}%`;
        plot.append(mark);
      }

      entries.forEach((entry, index) => {
        const value = score(entry);
        if (value === null) return;
        const dot = element("button", "", "post-axis-dot");
        dot.type = "button";
        dot.dataset.entryId = entry.id;
        dot.style.top = `${axisY(value)}%`;
        dot.style.left = `${24 + ((index * 37) % 68)}%`;
        dot.style.opacity = isVisible(entry) ? "1" : "0.23";
        dot.title = `${entry.title} · ${displayScore(entry)}`;
        dot.setAttribute("aria-label", dot.title);
        dot.addEventListener(
          "click",
          () => {
            selectedId = entry.id;
            unknownOnly = false;
            if (!isVisible(entry)) {
              minimum = 0;
              maximum = 100;
            }
            render();
            root
              ?.querySelector<HTMLElement>(
                `[data-post-list] [data-entry-id="${entry.id}"]`
              )
              ?.scrollIntoView({ behavior: "smooth", block: "center" });
          },
          { signal }
        );
        plot.append(dot);
      });

      if (mode === "llm" && unknownCount) {
        const unknown = element(
          "button",
          String(unknownCount),
          "post-axis-unknown"
        );
        unknown.type = "button";
        unknown.title = `${unknownCount} 篇无依据文章；位置不代表 50%`;
        unknown.setAttribute("aria-label", unknown.title);
        unknown.addEventListener(
          "click",
          () => {
            unknownOnly = true;
            render();
          },
          { signal }
        );
        plot.append(unknown);
      }

      const selected = entries.find(entry => entry.id === selectedId);
      if (mode === "llm" && selected?.llm.kind === "estimated") {
        const uncertainty = element("div", "", "post-axis-uncertainty");
        const low = Math.min(axisY(selected.llm.low), axisY(selected.llm.high));
        const high = Math.max(
          axisY(selected.llm.low),
          axisY(selected.llm.high)
        );
        uncertainty.style.top = `${low}%`;
        uncertainty.style.bottom = `${100 - high}%`;
        uncertainty.title = `不确定范围 ${selected.llm.low}–${selected.llm.high}%`;
        plot.append(uncertainty);
      }
      if (mode === "llm" && selected?.llm.kind === "no-evidence") {
        const uncertainty = element("div", "", "post-axis-unknown-range");
        uncertainty.title = "无依据：可能范围为 0–100%，位置不是估计值";
        plot.append(uncertainty);
      }

      for (const edge of ["min", "max"] as const) {
        const handle = element("button", "", "post-axis-handle");
        handle.type = "button";
        handle.style.top = `${axisY(edge === "min" ? minimum : maximum)}%`;
        handle.title = `拖动${edge === "min" ? "下限" : "上限"}`;
        handle.setAttribute("aria-label", handle.title);
        handle.addEventListener(
          "pointerdown",
          event => {
            event.preventDefault();
            const rect = plot.getBoundingClientRect();
            const move = (moveEvent: PointerEvent) => {
              const ratio = Math.max(
                0,
                Math.min(1, (moveEvent.clientY - rect.top) / rect.height)
              );
              const next = Math.round(
                ascending ? ratio * 100 : (1 - ratio) * 100
              );
              if (edge === "min") minimum = Math.min(next, maximum);
              else maximum = Math.max(next, minimum);
              unknownOnly = false;
              render();
            };
            window.addEventListener("pointermove", move, { signal });
            window.addEventListener(
              "pointerup",
              () => window.removeEventListener("pointermove", move),
              { once: true, signal }
            );
          },
          { signal }
        );
        plot.append(handle);
      }
      highlightSelection();
    }

    function render() {
      const visible = entries.filter(isVisible).sort(compare);
      if (!visible.some(entry => entry.id === selectedId)) {
        selectedId = visible[0]?.id;
      }
      const list = root?.querySelector<HTMLOListElement>("[data-post-list]");
      list?.replaceChildren(...visible.map(makeRow));
      root
        ?.querySelector<HTMLElement>("[data-empty]")
        ?.classList.toggle("hidden", visible.length > 0);
      const count = root?.querySelector<HTMLElement>("[data-result-count]");
      if (count)
        count.textContent = unknownOnly
          ? `无依据：${visible.length} 篇文章`
          : `显示 ${visible.length} / ${entries.length} 篇文章`;
      const sort = root?.querySelector<HTMLButtonElement>("[data-sort]");
      if (sort)
        sort.textContent = `排序：${ascending ? "低 → 高" : "高 → 低"} ↕`;
      const minInput = root?.querySelector<HTMLInputElement>("[data-min]");
      const maxInput = root?.querySelector<HTMLInputElement>("[data-max]");
      if (minInput) minInput.value = String(minimum);
      if (maxInput) maxInput.value = String(maximum);
      const unknownButton =
        root?.querySelector<HTMLButtonElement>("[data-unknown]");
      if (unknownButton)
        unknownButton.textContent = unknownOnly
          ? "返回数值结果"
          : `查看无依据（${unknownCount}）`;
      const range = root?.querySelector<HTMLElement>("[data-range-label]");
      if (range)
        range.textContent = `${minimum}–${maximum}${mode === "value" ? " 分" : "%"}`;
      const plot = root?.querySelector<HTMLElement>("[data-axis-plot]");
      if (plot) addPlot(plot, visible);
    }

    root.querySelector("[data-sort]")?.addEventListener(
      "click",
      () => {
        ascending = !ascending;
        render();
      },
      { signal }
    );
    root.querySelector("[data-reset]")?.addEventListener(
      "click",
      () => {
        minimum = 0;
        maximum = 100;
        unknownOnly = false;
        render();
      },
      { signal }
    );
    root.querySelector("[data-unknown]")?.addEventListener(
      "click",
      () => {
        unknownOnly = !unknownOnly;
        render();
      },
      { signal }
    );
    root.querySelector<HTMLInputElement>("[data-min]")?.addEventListener(
      "change",
      event => {
        const value = Number((event.target as HTMLInputElement).value);
        minimum = Number.isFinite(value)
          ? Math.max(0, Math.min(maximum, Math.round(value)))
          : minimum;
        unknownOnly = false;
        render();
      },
      { signal }
    );
    root.querySelector<HTMLInputElement>("[data-max]")?.addEventListener(
      "change",
      event => {
        const value = Number((event.target as HTMLInputElement).value);
        maximum = Number.isFinite(value)
          ? Math.min(100, Math.max(minimum, Math.round(value)))
          : maximum;
        unknownOnly = false;
        render();
      },
      { signal }
    );
    render();
  }

  document.addEventListener("astro:page-load", initPostAxis);
</script>

<style is:global>
  .post-axis-selected {
    border-color: var(--accent) !important;
  }
  .post-axis-plot {
    position: relative;
    user-select: none;
  }
  .post-axis-line {
    position: absolute;
    top: 8%;
    bottom: 8%;
    left: 50%;
    width: 2px;
    background: var(--border);
  }
  .post-axis-range-band {
    position: absolute;
    left: calc(50% - 12px);
    width: 24px;
    border-radius: 12px;
    background: color-mix(in srgb, var(--accent) 12%, transparent);
    pointer-events: none;
  }
  .post-axis-tick {
    position: absolute;
    left: 0;
    transform: translateY(-50%);
    color: var(--muted-foreground);
    font: 12px monospace;
  }
  .post-axis-dot {
    position: absolute;
    z-index: 2;
    width: 18px;
    height: 18px;
    border: 0;
    border-radius: 50%;
    background: transparent;
    transform: translate(-50%, -50%);
    cursor: pointer;
  }
  .post-axis-dot::after {
    content: "";
    position: absolute;
    top: 50%;
    left: 50%;
    width: 8px;
    height: 8px;
    border: 1px solid var(--accent);
    border-radius: 50%;
    background: var(--accent);
    transform: translate(-50%, -50%);
  }
  .post-axis-dot.post-axis-selected::after {
    width: 12px;
    height: 12px;
    box-shadow:
      0 0 0 3px var(--background),
      0 0 0 5px var(--accent);
  }
  .post-axis-unknown {
    position: absolute;
    z-index: 3;
    top: 50%;
    left: 88%;
    width: 34px;
    height: 34px;
    border: 2px solid var(--accent);
    border-radius: 50%;
    background: var(--background);
    color: var(--accent);
    font: 600 11px monospace;
    transform: translate(-50%, -50%);
    cursor: pointer;
  }
  .post-axis-uncertainty {
    position: absolute;
    z-index: 1;
    left: 47%;
    width: 6%;
    background: color-mix(in srgb, var(--accent) 32%, transparent);
    pointer-events: none;
  }
  .post-axis-unknown-range {
    position: absolute;
    top: 8%;
    bottom: 8%;
    left: 87%;
    width: 3px;
    border-left: 2px dashed var(--accent);
    opacity: 0.4;
    pointer-events: none;
  }
  .post-axis-handle {
    position: absolute;
    z-index: 4;
    left: 50%;
    width: 34px;
    height: 14px;
    border: 2px solid var(--accent);
    border-radius: 9px;
    background: var(--background);
    transform: translate(-50%, -50%);
    cursor: ns-resize;
    touch-action: none;
  }
  @media (max-width: 79.999rem) {
    .post-axis-layout {
      grid-template-columns: minmax(100px, 26%) minmax(0, 1fr);
    }
  }
  @media (max-width: 35rem) {
    .post-axis-layout {
      grid-template-columns: 88px minmax(0, 1fr);
      gap: 12px;
    }
    .post-axis-tick {
      font-size: 10px;
    }
    .post-axis-unknown {
      left: 82%;
      width: 30px;
      height: 30px;
      font-size: 10px;
    }
  }
</style>
