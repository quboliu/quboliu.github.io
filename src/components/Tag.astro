---
import { getRelativeLocaleUrl } from "astro:i18n";
import config from "@/config";
import { getTagLabel } from "@/utils/getTagLabel";

type Props = {
  tag: string;
  tagName: string;
  size?: "sm" | "lg";
};

const { tag, tagName, size = "lg" } = Astro.props;

const locale = Astro.currentLocale ?? config.site.lang;
---

<li>
  <a
    href={getRelativeLocaleUrl(locale, `tags/${tag}/`)}
    transition:name={tag}
    class:list={[
      "text-muted-foreground hover:text-accent no-underline transition-colors hover:underline",
      { "text-sm": size === "sm" },
    ]}
  >
    #{getTagLabel(tagName, locale === "en")}
  </a>
</li>
