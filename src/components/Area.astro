---
import { getRelativeLocaleUrl } from "astro:i18n";
import { getAreaBySlug, type AreaSlug } from "@/data/areas";
import config from "@/config";

type Props = {
  area: AreaSlug;
};

const { area } = Astro.props;
const definition = getAreaBySlug(area);

if (!definition) {
  throw new Error(`Unknown Area slug: ${area}`);
}

const locale = Astro.currentLocale ?? config.site.lang;
---

<a
  href={getRelativeLocaleUrl(locale, `areas/${definition.slug}/`)}
  transition:name={`area-${definition.slug}`}
  class="text-accent no-underline hover:underline"
>
  {definition.name}
</a>
