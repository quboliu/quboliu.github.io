---
import type { Project } from "@/data/projects";

type Props = {
  project: Project;
  index?: number;
};

const { project, index = 0 } = Astro.props;
---

<li class="group flex min-w-0">
  <a
    href={project.url}
    target="_blank"
    rel="noopener noreferrer"
    class="border-border bg-background hover:border-accent/70 hover:bg-muted/35 focus-visible:border-accent flex w-full min-w-0 flex-col overflow-hidden rounded-2xl border p-5 no-underline transition duration-200 hover:-translate-y-1"
    aria-label={`${project.name}（在 GitHub 中打开）`}
  >
    <div class="mb-6 flex items-start justify-between gap-4">
      <span
        class="text-muted-foreground text-xs font-semibold tracking-[0.18em]"
        aria-hidden="true"
      >
        {String(index + 1).padStart(2, "0")}
      </span>
      <span
        class="border-border text-muted-foreground group-hover:text-accent rounded-full border px-2.5 py-1 text-xs transition-colors"
      >
        {project.language}
      </span>
    </div>

    <h3
      class="group-hover:text-accent text-lg font-bold wrap-break-word transition-colors"
    >
      {project.name}
      <span
        class="ms-1 inline-block transition-transform group-hover:translate-x-1"
      >
        ↗
      </span>
    </h3>
    <p class="text-muted-foreground mt-2 grow text-sm leading-6">
      {project.description}
    </p>
    <ul class="mt-5 flex flex-wrap gap-2" aria-label="项目标签">
      {
        project.tags.map(tag => (
          <li class="bg-muted/70 rounded-md px-2 py-1 text-xs">{tag}</li>
        ))
      }
    </ul>
  </a>
</li>
