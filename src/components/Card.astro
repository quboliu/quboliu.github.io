---
import type { CollectionEntry } from "astro:content";
import { getPostUrl } from "@/utils/getPostPaths";
import { toTransitionName } from "@/utils/toTransitionName";
import ContentTypeBadge from "@/components/ContentTypeBadge.astro";
import dayjs from "dayjs";

type Props = {
  variant?: "h2" | "h3";
} & CollectionEntry<"posts">;

const { variant: Heading = "h2", id, data, filePath } = Astro.props;

const { title, lang, pubDatetime, contentType } = data;
const date = dayjs(pubDatetime).format("YYYY-MM-DD");
---

<li class="flex gap-2 py-0.5">
  <span
    aria-hidden="true"
    class="text-muted-foreground shrink-0 basis-[130px] font-mono text-[15px]"
    >{date}</span
  >
  <div class="min-w-0">
    <ContentTypeBadge {contentType} class="me-1 align-[0.08em]" />
    <a
      href={getPostUrl(id, filePath, Astro.currentLocale)}
      class="text-accent visited:text-visited no-underline hover:underline"
    >
      <Heading
        lang={lang}
        transition:name={toTransitionName(title)}
        class="inline"
      >
        {title}
      </Heading>
    </a>
  </div>
</li>
