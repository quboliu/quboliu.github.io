---
type Props = {
  heading?: string;
  showDivider?: boolean;
};

const { heading = "Comments", showDivider = true } = Astro.props;
const repoId = import.meta.env.PUBLIC_GISCUS_REPO_ID;
const categoryId = import.meta.env.PUBLIC_GISCUS_CATEGORY_ID;
const configured = Boolean(repoId && categoryId);
---

{
  (configured || import.meta.env.DEV) && (
    <section
      class:list={{ "mt-10": showDivider }}
      aria-labelledby="comments-title"
    >
      {showDivider && <hr class="border-border mb-8" />}
      <h2 id="comments-title" class="mb-6 text-xl font-semibold">
        {heading}
      </h2>
      {configured ? (
        <script
          is:inline
          src="https://giscus.app/client.js"
          data-repo="quboliu/quboliu.github.io"
          data-repo-id={repoId}
          data-category="Announcements"
          data-category-id={categoryId}
          data-mapping="pathname"
          data-strict="0"
          data-reactions-enabled="1"
          data-emit-metadata="0"
          data-input-position="top"
          data-theme="preferred_color_scheme"
          data-lang="en"
          data-loading="lazy"
          crossorigin="anonymous"
          async
        />
      ) : (
        <p class="border-border bg-muted/40 text-muted-foreground rounded border p-4 text-sm">
          Development note: enable GitHub Discussions and set both public Giscus
          environment variables to show comments here.
        </p>
      )}
    </section>
  )
}
