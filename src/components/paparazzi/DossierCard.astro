---
import type { CollectionEntry } from "astro:content";
import { getRelativeLocaleUrl } from "astro:i18n";
import Avatar from "@/components/Avatar.astro";
import config from "@/config";
import { SUBJECT_TYPE_NAMES } from "@/data/paparazziCategories";
import { dossierSlug } from "@/utils/paparazzi";
interface Props {
  page: CollectionEntry<"pages">;
}
const { page } = Astro.props;
const name = page.data.subjectName ?? page.data.title;
const locale = Astro.currentLocale ?? config.site.lang;
const isPerson = page.data.subjectType === "person";
---

<li class="h-full">
  <a
    href={getRelativeLocaleUrl(locale, `paparazzi/${dossierSlug(page)}`)}
    class="dossier-card border-border hover:border-accent/60 flex h-full flex-col rounded-xl border p-4 no-underline transition-colors sm:p-5"
    aria-label={`阅读 ${name} 档案`}
  >
    <div class="mb-4 flex items-center gap-3">
      <span
        class:list={[
          "border-border block h-14 w-14 shrink-0 overflow-hidden border",
          isPerson ? "rounded-full" : "rounded-xl",
        ]}
      >
        <Avatar
          candidates={page.data.avatarCandidates}
          alt={`${name} ${isPerson ? "头像" : "标识"}`}
          fallback={isPerson
            ? Array.from(name).slice(0, 2).join("").toUpperCase()
            : name.slice(0, 1)}
        />
      </span>
      <div class="min-w-0">
        <span class="text-muted-foreground mb-1 block text-xs"
          >{SUBJECT_TYPE_NAMES[page.data.subjectType]}</span
        >
        <h3 class="text-foreground text-base leading-snug font-semibold">
          {name}
        </h3>
      </div>
    </div>
    <p class="text-muted-foreground mb-4 text-sm leading-relaxed">
      {page.data.description}
    </p>
    <div
      class="text-muted-foreground mt-auto flex flex-wrap items-center justify-between gap-2 text-xs"
    >
      {
        page.data.verifiedDate && (
          <span>
            核查于{" "}
            <time datetime={page.data.verifiedDate}>
              {page.data.verifiedDate}
            </time>
          </span>
        )
      }
      <span class="text-accent ml-auto"
        >阅读档案 <span aria-hidden="true">→</span></span
      >
    </div>
  </a>
</li>
<style>
  .dossier-card p {
    text-align: justify;
    text-align-last: start;
    hyphens: auto;
  }
</style>
