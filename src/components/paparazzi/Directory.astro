---
import { getRelativeLocaleUrl } from "astro:i18n";
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import DossierCard from "./DossierCard.astro";
import config from "@/config";
import {
  PAPARAZZI_CATEGORIES,
  getPaparazziCategory,
} from "@/data/paparazziCategories";
import { PAPARAZZI_TIERS } from "@/data/paparazziTiers";
import { getPaparazziDossiers } from "@/utils/paparazzi";
interface Props {
  categorySlug?: string;
}
const { categorySlug } = Astro.props;
const activeCategory = categorySlug
  ? getPaparazziCategory(categorySlug)
  : undefined;
const pages = await getPaparazziDossiers();
const locale = Astro.currentLocale ?? config.site.lang;
const rootUrl = getRelativeLocaleUrl(locale, "paparazzi");
const categoryUrl = (slug: string) =>
  getRelativeLocaleUrl(locale, `paparazzi/category/${slug}`);
const categories = PAPARAZZI_CATEGORIES.filter(
  category => !categorySlug || category.slug === categorySlug
);
const description =
  activeCategory?.description ??
  "追踪人物、公司与产品，整理它们的作品、演变与关键事件。";
---

<Layout
  title={`${activeCategory ? activeCategory.name + " | " : ""}Paparazzi | ${config.site.title}`}
  description={description}
>
  <Header />
  <main id="main-content" class="app-layout pt-8 pb-12" lang="zh-CN">
    <div class="text-muted-foreground mb-5 flex items-center gap-2 text-sm">
      <a href={getRelativeLocaleUrl(locale, "")} class="hover:text-accent"
        >首页</a
      ><span aria-hidden="true">/</span>
      {
        activeCategory ? (
          <>
            <>
              <a href={rootUrl} class="hover:text-accent">
                Paparazzi
              </a>
              <span aria-hidden="true">/</span>
              <span aria-current="page">{activeCategory.name}</span>
            </>
          </>
        ) : (
          <span aria-current="page">Paparazzi</span>
        )
      }
    </div>
    <div class="mb-7">
      <p class="text-accent mb-2 text-xs font-medium tracking-widest">
        持续观察 · 公开资料 · 独立档案
      </p>
      <h1 class="text-2xl font-semibold sm:text-3xl">
        {activeCategory?.name ?? "Paparazzi"}
      </h1>
      <p class="text-muted-foreground mt-3 leading-relaxed">{description}</p>
    </div>
    <nav
      aria-label="档案栏目"
      class="border-border mb-9 flex flex-wrap gap-2 border-b pb-5"
    >
      <a
        href={rootUrl}
        aria-current={!categorySlug ? "page" : undefined}
        class:list={[
          "rounded-full px-4 py-2 text-sm transition-colors",
          !categorySlug
            ? "bg-accent text-background"
            : "bg-accent/5 hover:bg-accent/10",
        ]}>全部 <span class="ml-1 opacity-70">{pages.length}</span></a
      >
      {
        PAPARAZZI_CATEGORIES.map(category => (
          <a
            href={categoryUrl(category.slug)}
            aria-current={categorySlug === category.slug ? "page" : undefined}
            class:list={[
              "rounded-full px-4 py-2 text-sm transition-colors",
              categorySlug === category.slug
                ? "bg-accent text-background"
                : "bg-accent/5 hover:bg-accent/10",
            ]}
          >
            {category.name}{" "}
            <span class="ml-1 opacity-70">
              {
                pages.filter(
                  page => page.data.paparazziCategory === category.slug
                ).length
              }
            </span>
          </a>
        ))
      }
    </nav>
    <div class="space-y-10">
      {
        categories.map(category => {
          const categoryPages = pages.filter(
            page => page.data.paparazziCategory === category.slug
          );
          const groups =
            category.slug === "people"
              ? PAPARAZZI_TIERS.map(tier => ({
                  name: tier.name,
                  description: tier.description,
                  pages: categoryPages.filter(
                    page => page.data.paparazziTier === tier.slug
                  ),
                })).filter(group => group.pages.length)
              : [{ name: "", description: "", pages: categoryPages }];
          return (
            <section aria-label={category.name}>
              {!activeCategory && (
                <div class="mb-5">
                  <div class="flex items-center justify-between gap-4">
                    <h2 class="text-xl font-semibold">
                      {category.name}{" "}
                      <span class="text-muted-foreground text-sm font-normal">
                        {categoryPages.length}
                      </span>
                    </h2>
                    <a
                      href={categoryUrl(category.slug)}
                      class="text-accent shrink-0 text-sm"
                    >
                      查看全部 <span aria-hidden="true">→</span>
                    </a>
                  </div>
                  <p class="text-muted-foreground mt-2 text-sm">
                    {category.description}
                  </p>
                </div>
              )}
              {categoryPages.length ? (
                <div class="space-y-6">
                  {groups.map(group => (
                    <div>
                      {group.name && (
                        <div class="mb-3">
                          <h2 class="text-base font-semibold">{group.name}</h2>
                          <p class="text-muted-foreground mt-1 text-sm">
                            {group.description}
                          </p>
                        </div>
                      )}
                      <ul class="grid list-none grid-cols-1 gap-3 p-0 sm:grid-cols-2 lg:grid-cols-3">
                        {(activeCategory
                          ? group.pages
                          : group.pages.slice(
                              0,
                              category.slug === "people" ? 3 : 6
                            )
                        ).map(page => (
                          <DossierCard page={page} />
                        ))}
                      </ul>
                    </div>
                  ))}
                </div>
              ) : (
                <p class="text-muted-foreground border-border rounded-xl border border-dashed p-6 text-sm">
                  这个栏目还没有档案，后续将在这里持续补充。
                </p>
              )}
            </section>
          );
        })
      }
    </div>
    <p
      class="text-muted-foreground border-border mt-10 border-t pt-5 text-xs leading-relaxed"
    >
      档案以公开资料为依据。核查日期表示资料核验时间；人物档位依据公开作品与影响，不用于公司或产品排名。
    </p>
  </main>
  <Footer />
</Layout>
<style>
  main p {
    text-align: justify;
    text-align-last: start;
    hyphens: auto;
  }
</style>
