---
import {
  POST_VALUE_ASSESSMENTS,
  POST_VALUE_REVIEWED_AT,
} from "@/data/postValueAssessments";
import { getPostLlmAssessment } from "@/data/postLlmAssessments";

type Props = { postId: string };
const { postId } = Astro.props;
const value = POST_VALUE_ASSESSMENTS[postId];
const llm = getPostLlmAssessment(postId);
const english = Astro.currentLocale === "en";
const copy = english
  ? {
      siteAssessment: "Assessment of the original",
      value: "Reading value",
      scale: `Editorial assessment on a fixed scale. Reviewed on ${POST_VALUE_REVIEWED_AT}. Scores do not express ratios of value.`,
      llm: "LLM content in the source text",
      roles: "Model involvement",
      unrecorded: "Unrecorded",
      scope: "Scope",
      note: "The estimate covers the original prose added by this site. The translation, third-party text, quotations, code, and figures are outside its scope.",
    }
  : {
      siteAssessment: "本站评估",
      value: "阅读价值",
      scale: `固定量尺的编辑评价；审阅于 ${POST_VALUE_REVIEWED_AT}。数值不表示价值倍数。`,
      llm: "LLM 文字含量",
      roles: "参与环节",
      unrecorded: "未记录",
      scope: "统计范围",
      note: "比例只针对本站新增自然语言正文；第三方原文、引文、代码和图示不计入。",
    };
function getLlmLabel() {
  if (llm.kind === "no-evidence")
    return english ? "No evidence · 0–100%" : "无依据 · 0–100%";
  if (llm.kind === "no-added-prose")
    return english ? "0% · No added prose" : "0% · 无新增正文";
  return english
    ? `≈ ${llm.estimate}% · Range ${llm.low}–${llm.high}%`
    : `约 ${llm.estimate}% · 范围 ${llm.low}–${llm.high}%`;
}

const llmLabel = getLlmLabel();
const valueReason = english ? value?.reasonEn : undefined;
const llmBasis = english ? llm.basisEn : undefined;
---

{
  value && (
    <details class="border-border bg-muted/20 max-w-app mt-6 rounded border px-4 py-3 text-sm">
      <summary class="cursor-pointer font-medium">
        {copy.siteAssessment}
        {english ? ": " : "："}
        {copy.value} {value.score}/100 · {copy.llm} {llmLabel}
      </summary>
      <div class="mt-3 space-y-2">
        <p>
          <strong>
            {copy.value}
            {english ? ":" : "："}
          </strong>
          <span lang={english && valueReason ? "en" : "zh-CN"}>
            {valueReason ?? value.reason}
          </span>
        </p>
        <p class="text-muted-foreground text-xs">{copy.scale}</p>
        <p>
          <strong>
            {copy.llm}
            {english ? ":" : "："}
          </strong>
          {llmLabel}
          {english ? ". " : "。"}
          <span lang={english && llmBasis ? "en" : "zh-CN"}>
            {llmBasis ?? llm.basis}
          </span>
        </p>
        <p>
          <strong>
            {copy.roles}
            {english ? ":" : "："}
          </strong>
          {llm.roles.length ? (
            <span lang="zh-CN">{llm.roles.join("、")}</span>
          ) : (
            copy.unrecorded
          )}
        </p>
        <p>
          <strong>
            {copy.scope}
            {english ? ":" : "："}
          </strong>
          {english ? "Original prose added by this site." : llm.scope}
        </p>
        <p class="text-muted-foreground text-xs">{copy.note}</p>
      </div>
    </details>
  )
}
