---
import { getRelativeLocaleUrl } from "astro:i18n";
import { useTranslations } from "@/i18n";
import config from "@/config";

type View = "timeline" | "areas" | "tags" | "types";

type Props = {
  active: View;
};

const { active } = Astro.props;
const locale = Astro.currentLocale ?? config.site.lang;
const t = useTranslations(locale);

const views = [
  {
    key: "timeline" as const,
    href: getRelativeLocaleUrl(locale, "reposts"),
    label: t.views.timeline,
  },
  {
    key: "areas" as const,
    href: getRelativeLocaleUrl(locale, "reposts/areas"),
    label: t.views.areas,
  },
  {
    key: "tags" as const,
    href: getRelativeLocaleUrl(locale, "reposts/tags"),
    label: t.views.tags,
  },
  {
    key: "types" as const,
    href: getRelativeLocaleUrl(locale, "reposts/types"),
    label: t.views.types,
  },
];
---

<nav class="border-border mb-6 border-b" aria-label="Repost views">
  <ul class="flex flex-wrap gap-x-5 gap-y-1" role="list">
    {
      views.map(({ key, href, label }) => (
        <li>
          <a
            href={href}
            aria-current={active === key ? "page" : undefined}
            class:list={[
              "inline-block border-b-2 border-transparent px-1 pb-2 text-sm no-underline transition-colors",
              {
                "text-accent border-accent font-medium": active === key,
                "text-muted-foreground hover:text-accent": active !== key,
              },
            ]}
          >
            {label}
          </a>
        </li>
      ))
    }
  </ul>
</nav>
