---
import {
  PUBLIC_UMAMI_SHARE_URL,
  PUBLIC_UMAMI_WEBSITE_ID,
} from "astro:env/client";

const hasCollector = Boolean(PUBLIC_UMAMI_WEBSITE_ID);
const hasDashboard = Boolean(PUBLIC_UMAMI_WEBSITE_ID && PUBLIC_UMAMI_SHARE_URL);
---

<section
  id="site-traffic"
  class="not-prose border-border bg-background mt-12 rounded border p-4 sm:p-6"
  aria-labelledby="site-traffic-title"
>
  {
    hasDashboard ? (
      <>
        <div class="mb-5 flex flex-wrap items-start justify-between gap-3">
          <div>
            <h2
              id="site-traffic-title"
              class="text-foreground text-xl font-semibold"
            >
              Site traffic
            </h2>
            <p class="text-muted-foreground mt-1 text-sm">
              Pageviews, visitors, top pages, referrers, devices, and other
              metrics enabled in the shared dashboard.
            </p>
          </div>
          <a
            href={PUBLIC_UMAMI_SHARE_URL}
            target="_blank"
            rel="noreferrer"
            class="text-accent text-sm hover:underline"
          >
            Open full dashboard
          </a>
        </div>
        <div class="border-border overflow-hidden rounded border">
          <iframe
            src={PUBLIC_UMAMI_SHARE_URL}
            title="Site traffic dashboard"
            loading="lazy"
            referrerpolicy="no-referrer"
            class="h-[min(720px,80svh)] w-full border-0"
          />
        </div>
      </>
    ) : (
      <>
        <h2
          id="site-traffic-title"
          class="text-foreground text-xl font-semibold"
        >
          {hasCollector
            ? "Traffic collection is enabled"
            : "Analytics is ready to connect"}
        </h2>
        <p class="text-muted-foreground mt-2">
          {hasCollector
            ? "The collector is receiving data. A public dashboard link has not been enabled yet."
            : "Once the analytics connection is enabled, this section will show the site's visitor and traffic overview."}
        </p>
        <p class="text-muted-foreground mt-3 text-sm">
          The site uses an anonymous, privacy-friendly setup. No analytics API
          key is exposed in the browser.
        </p>
      </>
    )
  }
</section>
