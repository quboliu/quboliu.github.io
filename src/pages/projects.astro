---
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Breadcrumb from "@/components/Breadcrumb.astro";
import Footer from "@/components/Footer.astro";
import ProjectCard from "@/components/ProjectCard.astro";
import { projects } from "@/data/projects";
import config from "@/config";
---

<Layout
  title={`项目 | ${config.site.title}`}
  description="蘧伯流维护和探索的开源项目。"
>
  <Header />
  <Breadcrumb />

  <main id="main-content" class="app-layout pb-12">
    <div class="mb-10 max-w-2xl">
      <p class="text-accent mb-3 text-sm font-semibold tracking-[0.16em]">
        OPEN SOURCE
      </p>
      <h1 class="text-3xl font-bold sm:text-4xl">正在做的项目</h1>
      <p class="text-muted-foreground mt-4 leading-7">
        工具是想法的可执行版本。这里收录我正在维护、打磨和验证的开源项目。
      </p>
    </div>

    <ul class="grid gap-4 md:grid-cols-2">
      {projects.map((project, index) => <ProjectCard {project} {index} />)}
    </ul>
  </main>

  <Footer />
</Layout>
