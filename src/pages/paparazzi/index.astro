---
import { getCollection } from "astro:content";
import { getRelativeLocaleUrl } from "astro:i18n";
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Breadcrumb from "@/components/Breadcrumb.astro";
import Main from "@/components/Main.astro";
import Footer from "@/components/Footer.astro";
import Avatar from "@/components/Avatar.astro";
import config from "@/config";

const locale = Astro.currentLocale ?? config.site.lang;
const paparazziPages = (
  await getCollection("pages", ({ id }) => id.startsWith("paparazzi/"))
).sort((a, b) => a.data.title.localeCompare(b.data.title));

const tierOrder = ["top", "star", "indie"] as const;
const tierLabels = {
  top: "Top-tier dossiers",
  star: "Star engineer dossiers",
  indie: "Independent technologist dossiers",
} as const;

const getSlug = (id: string) => id.split("/").at(-1) ?? id;
const getInitials = (name: string) =>
  Array.from(name.trim()).slice(0, 2).join("").toUpperCase() || "?";

const unclassifiedPages = paparazziPages.filter(
  page => !page.data.paparazziTier
);

if (unclassifiedPages.length) {
  throw new Error(
    `Every Paparazzi dossier must declare paparazziTier (top, star, or indie): ${unclassifiedPages
      .map(page => page.id)
      .join(", ")}`
  );
}

const tieredPaparazziPages = tierOrder.map(tier => ({
  tier,
  pages: paparazziPages.filter(page => page.data.paparazziTier === tier),
}));
---

<Layout
  title={`Paparazzi | ${config.site.title}`}
  description="Independent dossiers tracking notable blogs and projects."
>
  <Header />

  <Breadcrumb />

  <Main
    pageTitle="Paparazzi"
    pageDesc="Independent dossiers tracking notable blogs and projects — separate from Posts. Public avatars are tried in priority order, with initials as the final fallback."
  >
    <div class="grid grid-cols-1 gap-y-2 sm:gap-y-2.5">
      {
        tieredPaparazziPages.map(({ tier, pages }) => (
          <section
            class="border-border w-full border-t pt-2 first:border-t-0 first:pt-0 sm:pt-3 sm:first:pt-0"
            aria-label={tierLabels[tier]}
          >
            <ul class="grid grid-cols-2 gap-x-0.5 gap-y-1 sm:grid-cols-3 sm:gap-x-1 sm:gap-y-1.5 md:grid-cols-4">
              {pages.map(page => {
                const slug = getSlug(page.id);
                const href = getRelativeLocaleUrl(locale, `paparazzi/${slug}`);
                const subjectName = page.data.subjectName ?? page.data.title;
                const avatarSources = page.data.avatarCandidates.map(
                  candidate => candidate.source
                );
                const avatarTitle = avatarSources.length
                  ? `Avatar priority: ${avatarSources.join(" → ")} → initials`
                  : "No public avatar found; using initials";

                return (
                  <li class="group flex justify-center text-center">
                    <a
                      href={href}
                      class="flex flex-col items-center no-underline"
                      aria-label={`Open ${subjectName} dossier`}
                    >
                      <span
                        class="border-border bg-background relative block h-12 w-12 overflow-hidden rounded-full border shadow-sm transition-transform duration-300 group-hover:scale-105 sm:h-14 sm:w-14"
                        title={avatarTitle}
                      >
                        <Avatar
                          candidates={page.data.avatarCandidates}
                          alt={`${subjectName} avatar`}
                          fallback={getInitials(subjectName)}
                        />
                      </span>
                      <span class="text-foreground mt-0.5 text-xs font-semibold">
                        {subjectName}
                      </span>
                      <span class="text-muted-foreground mt-0.5 text-[10px]">
                        {page.data.title}
                      </span>
                    </a>
                  </li>
                );
              })}
            </ul>
          </section>
        ))
      }
    </div>
  </Main>

  <Footer />
</Layout>
