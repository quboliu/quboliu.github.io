---
import { getCollection } from "astro:content";
import { getRelativeLocaleUrl } from "astro:i18n";
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Breadcrumb from "@/components/Breadcrumb.astro";
import Main from "@/components/Main.astro";
import Footer from "@/components/Footer.astro";
import Avatar from "@/components/Avatar.astro";
import config from "@/config";
import { PAPARAZZI_TIERS } from "@/data/paparazziTiers";

const locale = Astro.currentLocale ?? config.site.lang;
const paparazziPages = (
  await getCollection("pages", ({ id }) => id.startsWith("paparazzi/"))
).sort((a, b) => a.data.title.localeCompare(b.data.title));

const getSlug = (id: string) => id.split("/").at(-1) ?? id;
const getInitials = (name: string) =>
  Array.from(name.trim()).slice(0, 2).join("").toUpperCase() || "?";

const unclassifiedPages = paparazziPages.filter(
  page => !page.data.paparazziTier
);

if (unclassifiedPages.length) {
  throw new Error(
    `Every Paparazzi dossier must declare paparazziTier (${PAPARAZZI_TIERS.map(({ slug }) => slug).join(", ")}): ${unclassifiedPages
      .map(page => page.id)
      .join(", ")}`
  );
}

const tieredPaparazziPages = PAPARAZZI_TIERS.map(tier => ({
  ...tier,
  pages: paparazziPages.filter(page => page.data.paparazziTier === tier.slug),
}));
---

<Layout
  title={`Paparazzi | ${config.site.title}`}
  description="Independent dossiers tracking notable blogs and projects."
>
  <Header />

  <Breadcrumb />

  <Main
    pageTitle="Paparazzi"
    pageDesc="Independent dossiers tracking notable blogs and projects — separate from Posts. Public avatars are tried in priority order, with initials as the final fallback."
  >
    <div class="grid grid-cols-1 gap-y-1 sm:gap-y-1.5">
      {
        tieredPaparazziPages.map(({ name, description, pages }) => (
          <section
            class="border-border w-full border-t pt-5 first:border-t-0 first:pt-0"
            aria-label={name}
          >
            <h2 class="text-foreground text-lg font-semibold">
              {name}{" "}
              <span class="text-muted-foreground text-sm">
                ({pages.length})
              </span>
            </h2>
            <p class="text-muted-foreground mb-3 text-sm">{description}</p>
            <ul class="grid grid-cols-2 gap-x-0 gap-y-2 sm:grid-cols-3 sm:gap-x-0.5 sm:gap-y-2 md:grid-cols-4">
              {pages.map(page => {
                const slug = getSlug(page.id);
                const href = getRelativeLocaleUrl(locale, `paparazzi/${slug}`);
                const subjectName = page.data.subjectName ?? page.data.title;
                const avatarSources = page.data.avatarCandidates.map(
                  candidate => candidate.source
                );
                const avatarTitle = avatarSources.length
                  ? `Avatar priority: ${avatarSources.join(" → ")} → initials`
                  : "No public avatar found; using initials";

                return (
                  <li class="group flex justify-center text-center">
                    <a
                      href={href}
                      class="flex flex-col items-center no-underline"
                      aria-label={`Open ${subjectName} dossier`}
                    >
                      <span
                        class="border-border bg-background relative block h-[84px] w-[84px] overflow-hidden rounded-full border shadow-sm transition-transform duration-300 group-hover:scale-105 sm:h-24 sm:w-24"
                        title={avatarTitle}
                      >
                        <Avatar
                          candidates={page.data.avatarCandidates}
                          alt={`${subjectName} avatar`}
                          fallback={getInitials(subjectName)}
                        />
                      </span>
                      <span class="text-foreground text-sm leading-tight font-semibold">
                        {subjectName}
                      </span>
                    </a>
                  </li>
                );
              })}
            </ul>
          </section>
        ))
      }
    </div>
  </Main>

  <Footer />
</Layout>
