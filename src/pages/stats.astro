---
import {
  PUBLIC_UMAMI_SHARE_URL,
  PUBLIC_UMAMI_WEBSITE_ID,
} from "astro:env/client";
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Breadcrumb from "@/components/Breadcrumb.astro";
import Main from "@/components/Main.astro";
import Footer from "@/components/Footer.astro";
import config from "@/config";

const statsLabel = "Stats";
const hasCollector = Boolean(PUBLIC_UMAMI_WEBSITE_ID);
const hasDashboard = Boolean(PUBLIC_UMAMI_WEBSITE_ID && PUBLIC_UMAMI_SHARE_URL);
---

<Layout
  title={statsLabel + " | " + config.site.title}
  description="Privacy-friendly visitor statistics for this site."
>
  <Header />

  <Breadcrumb />

  <Main
    pageTitle={statsLabel}
    pageDesc="A privacy-friendly view of site traffic, separate from the article content."
  >
    {
      hasDashboard ? (
        <section class="border-border bg-background rounded-lg border p-4 sm:p-6">
          <div class="mb-5 flex flex-wrap items-start justify-between gap-3">
            <div>
              <h2 class="text-xl font-semibold">Traffic dashboard</h2>
              <p class="text-muted-foreground mt-1 text-sm">
                Pageviews, visitors, top pages, referrers, devices, and other
                metrics enabled in the shared dashboard.
              </p>
            </div>
            <a
              href={PUBLIC_UMAMI_SHARE_URL}
              target="_blank"
              rel="noreferrer"
              class="text-accent text-sm hover:underline"
            >
              Open full dashboard
            </a>
          </div>
          <div class="border-border overflow-hidden rounded-lg border">
            <iframe
              src={PUBLIC_UMAMI_SHARE_URL}
              title="Site traffic dashboard"
              loading="lazy"
              referrerpolicy="no-referrer"
              class="h-[min(720px,80svh)] w-full border-0"
            />
          </div>
        </section>
      ) : (
        <section class="border-border bg-background rounded-lg border p-4 sm:p-6">
          <h2 class="text-xl font-semibold">
            {hasCollector
              ? "Traffic collection is enabled"
              : "Analytics is ready to connect"}
          </h2>
          <p class="text-muted-foreground mt-2">
            {hasCollector
              ? "The collector is receiving data. A public dashboard link has not been enabled yet."
              : "Once the analytics connection is enabled, this page will show the site's visitor and traffic overview."}
          </p>
          <p class="text-muted-foreground mt-3 text-sm">
            The site uses an anonymous, privacy-friendly setup. No analytics API
            key is exposed in the browser.
          </p>
        </section>
      )
    }
  </Main>

  <Footer />
</Layout>
