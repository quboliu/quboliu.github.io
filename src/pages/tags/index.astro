---
import { getCollection } from "astro:content";
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Breadcrumb from "@/components/Breadcrumb.astro";
import Main from "@/components/Main.astro";
import TagNavigation from "@/components/TagNavigation.astro";
import Footer from "@/components/Footer.astro";
import Card from "@/components/Card.astro";
import { getUniqueTags } from "@/utils/getUniqueTags";
import { slugifyStr } from "@/utils/slugify";
import { useTranslations } from "@/i18n";
import config from "@/config";

const posts = await getCollection("posts", ({ data }) => !data.draft);
const tags = getUniqueTags(posts);

const byPubDatetimeDesc = (
  a: (typeof posts)[number],
  b: (typeof posts)[number]
) =>
  new Date(b.data.pubDatetime).getTime() -
  new Date(a.data.pubDatetime).getTime();

const tagGroups = tags.map(({ tag, tagName }) => ({
  tag,
  tagName,
  posts: posts
    .filter(post => post.data.tags.some(t => slugifyStr(t) === tag))
    .sort(byPubDatetimeDesc),
}));

const tagLinks = tagGroups.map(({ tag, tagName, posts: tagPosts }) => ({
  slug: tag,
  name: tagName,
  count: tagPosts.length,
}));

const locale = Astro.currentLocale ?? config.site.lang;
const t = useTranslations(locale);
---

<Layout title={`${t.pages.tagsTitle} | ${config.site.title}`}>
  <Header />

  <Breadcrumb />

  <Main pageTitle={t.pages.tagsTitle} pageDesc={t.pages.tagsDesc} wide>
    <div class="grid gap-8 xl:grid-cols-[188px_minmax(0,1fr)]">
      <TagNavigation tags={tagLinks} />

      <div class="mx-auto w-full max-w-[800px] min-w-0 space-y-8 xl:mx-0">
        {
          tagGroups.map(({ tag, tagName, posts: tagPosts }) => (
            <section
              id={`tag-${tag}`}
              data-tag-section={tag}
              class="scroll-mt-20"
            >
              <h2 class="border-border border-b pb-2 text-base font-bold">
                <a
                  href={`#tag-${tag}`}
                  class="text-accent no-underline hover:underline"
                >
                  #{tagName}
                </a>
                <sup class="text-muted-foreground ms-1 text-sm font-normal">
                  {tagPosts.length}
                </sup>
              </h2>
              <ul class="tag-post-list mt-2">
                {tagPosts.map(data => (
                  <Card {...data} variant="h3" />
                ))}
              </ul>
            </section>
          ))
        }
      </div>
    </div>
  </Main>

  <Footer />
</Layout>

<style>
  @media (max-width: 40rem) {
    .tag-post-list :global(li > span) {
      flex-basis: 105px;
    }
  }
</style>
