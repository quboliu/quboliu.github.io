---
import { getRelativeLocaleUrl } from "astro:i18n";
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Main from "@/components/Main.astro";
import Footer from "@/components/Footer.astro";
import { useTranslations } from "@/i18n";
import config from "@/config";

const locale = Astro.currentLocale ?? config.site.lang;
const t = useTranslations(locale);
const destination = getRelativeLocaleUrl(locale, "posts/tags");
const canonicalURL = new URL(destination, config.site.url).href;
---

<Layout
  title={`${t.pages.tagsTitle} | ${t.pages.postsTitle} | ${config.site.title}`}
  description={t.pages.tagsDesc}
  {canonicalURL}
>
  <Fragment slot="head">
    <meta http-equiv="refresh" content={`0;url=${destination}`} />
  </Fragment>

  <Header />

  <Main pageTitle={t.pages.tagsTitle} pageDesc={t.pages.tagsDesc}>
    <p>
      This view now lives under <a
        class="text-accent underline"
        href={destination}>{t.pages.postsTitle} → {t.pages.tagsTitle}</a
      >.
    </p>
  </Main>

  <Footer />
</Layout>
