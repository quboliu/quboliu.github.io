---
import { getCollection } from "astro:content";
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Breadcrumb from "@/components/Breadcrumb.astro";
import Main from "@/components/Main.astro";
import PostsViewNavigation from "@/components/PostsViewNavigation.astro";
import TagDirectory from "@/components/TagDirectory.astro";
import Footer from "@/components/Footer.astro";
import { getTagGroups } from "@/utils/getTagGroups";
import { useTranslations } from "@/i18n";
import config from "@/config";

const locale = Astro.currentLocale ?? config.site.lang;
const t = useTranslations(locale);
const posts = await getCollection("posts", ({ data }) => !data.draft);
const tags = getTagGroups(posts).map(({ tag, tagName, posts: tagPosts }) => ({
  slug: tag,
  name: tagName,
  count: tagPosts.length,
}));
---

<Layout
  title={`${t.pages.tagsTitle} | ${t.pages.postsTitle} | ${config.site.title}`}
  description={t.pages.tagsDesc}
>
  <Header />

  <Breadcrumb />

  <Main pageTitle={t.pages.postsTitle} pageDesc={t.pages.tagsDesc} wide>
    <PostsViewNavigation active="tags" />

    <div class="mx-auto w-full max-w-[800px] min-w-0">
      <TagDirectory tags={tags} />
    </div>
  </Main>

  <Footer />
</Layout>
