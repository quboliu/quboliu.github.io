---
type Heading = { depth: number; slug: string; text: string };

type Props = {
  headings: Heading[];
};

const { headings } = Astro.props;
const toc = headings.filter(h => h.depth === 2 || h.depth === 3);
---

{
  toc.length > 0 && (
    <details class="article-toc">
      <summary>On this page</summary>
      <nav
        id="toc"
        aria-label="Table of contents"
        class="text-muted-foreground text-sm"
      >
        <ul class="space-y-1">
          {toc.map(h => (
            <li class:list={[{ "ps-3": h.depth === 3 }]}>
              <a
                href={`#${h.slug}`}
                data-toc-link={h.slug}
                class="hover:text-foreground block border-l-2 border-transparent ps-2 leading-snug break-words no-underline"
              >
                {h.text}
              </a>
            </li>
          ))}
        </ul>
      </nav>
    </details>
  )
}

<script>
  let controller: AbortController | undefined;
  document.addEventListener("astro:page-load", () => {
    controller?.abort();
    controller = new AbortController();
    const toc = document.querySelector<HTMLDetailsElement>(".article-toc");
    if (!toc) return;
    const wide = window.matchMedia("(min-width: 1200px)");
    const update = () => {
      toc.open = wide.matches;
    };
    update();
    wide.addEventListener("change", update, { signal: controller.signal });
  });
</script>
