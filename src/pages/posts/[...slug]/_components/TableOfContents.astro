---
type Heading = { depth: number; slug: string; text: string };

type Props = {
  headings: Heading[];
  bilingual?: boolean;
};

const { headings, bilingual = false } = Astro.props;
const toc = headings.filter(h => h.depth === 2 || h.depth === 3);

function formatTocText(text: string): string {
  if (!bilingual) return text;
  const match = text.match(/^(.*?)(?:｜|\s\/\s)([\s\S]*)$/);
  if (!match) return text;
  const before = match[1].trim();
  const after = match[2].trim();
  if (
    before &&
    !/\p{Script=Han}/u.test(before) &&
    /\p{Script=Han}/u.test(after)
  ) {
    return before;
  }
  return text;
}
---

{
  toc.length > 0 && (
    <nav
      id="toc"
      aria-label="Table of contents"
      class="text-muted-foreground border-border fixed top-28 z-10 hidden max-h-[70vh] max-w-56 overflow-y-auto border-l bg-transparent ps-3 text-sm xl:block 2xl:max-w-64"
    >
      <p class="text-foreground mb-2 font-semibold">On this page</p>
      <ul class="space-y-1">
        {toc.map(h => (
          <li class:list={[{ "ps-3": h.depth === 3 }]}>
            <a
              href={`#${h.slug}`}
              data-toc-link={h.slug}
              class="hover:text-foreground block border-l-2 border-transparent ps-2 leading-snug break-words no-underline"
            >
              {formatTocText(h.text)}
            </a>
          </li>
        ))}
      </ul>
    </nav>
  )
}

<style>
  nav {
    /* Keep the fixed outline inside the gutter beside the centered page. */
    --toc-edge: 1rem;
    inset-inline-end: var(--toc-edge);
    width: calc((100% - var(--container-app)) / 2 - var(--toc-edge));
  }
</style>
