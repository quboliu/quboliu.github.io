---
type Heading = { depth: number; slug: string; text: string };

type Props = {
  headings: Heading[];
};

const { headings } = Astro.props;
const toc = headings.filter(h => h.depth === 2 || h.depth === 3);
---

{
  toc.length > 0 && (
    <nav
      id="toc"
      aria-label="Table of contents"
      class="fixed top-28 right-4 z-10 hidden max-h-[70vh] w-56 overflow-y-auto rounded-lg border border-border bg-background/85 p-4 text-sm backdrop-blur-sm xl:block 2xl:w-64"
    >
      <p class="mb-2 font-semibold tracking-wide text-foreground">
        On this page
      </p>
      <ul class="space-y-1 border-l border-border">
        {toc.map(h => (
          <li class:list={[{ "ps-3": h.depth === 3 }]}>
            <a
              href={`#${h.slug}`}
              data-toc-link={h.slug}
              class="block border-l-2 border-transparent ps-2 leading-snug break-words text-muted-foreground no-underline hover:text-foreground"
            >
              {h.text}
            </a>
          </li>
        ))}
      </ul>
    </nav>
  )
}
